# PostgreSQL (usado por el servicio db y por DATABASE_URL del backend)
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=crm_password
POSTGRES_DB=crm_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://crm_user:crm_password@db:5432/crm_db

# JWT (se usa a partir de la Semana 2 - login)
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API (se usa a partir de la Semana 3 - resumen ejecutivo IA)
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=25

# App
APP_ENV=development

# Usuario admin creado por el script de seed (app/seed.py)
ADMIN_FULL_NAME=Administrador
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=change-this-admin-password
